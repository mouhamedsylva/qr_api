meta {
  name: Créer une sous-catégorie
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/restaurants/{{restaurantId}}/menu/categories
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

body:json {
  {
    "name": "Jus locaux",
    "parentId": "{{catBoissons}}"
  }
}

tests {
  test("Statut 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
