meta {
  name: Créer une boisson
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/restaurants/{{restaurantId}}/menu/items
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

body:json {
  {
    "categoryId": "{{catBoissons}}",
    "name": "Bissap",
    "priceAmount": 500,
    "costAmount": 100
  }
}

script:post-response {
  bru.setVar("itemBissap", res.getBody().id);
}

tests {
  test("Statut 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
