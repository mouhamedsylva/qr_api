meta {
  name: Performance du menu
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/restaurants/{{restaurantId}}/analytics/menu
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

tests {
  test("Statut 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Marge calculée", function () {
    const t = res.getBody().items.find((i) => i.name === "Thiéboudienne");
    expect(t.margin).to.be.a("number");
  });
}
