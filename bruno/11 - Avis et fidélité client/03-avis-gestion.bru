meta {
  name: Avis (gestion)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/restaurants/{{restaurantId}}/reviews
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

script:post-response {
  bru.setVar("reviewId", res.getBody().data[0].id);
}

tests {
  test("Statut 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
