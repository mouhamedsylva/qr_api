  token: {{ownerToken}}
}

body:json {
  {
    "currency": "XOF",
    "locale": "fr-SN",
    "timezone": "Africa/Dakar"
  }
}

tests {
  test("Statut 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
