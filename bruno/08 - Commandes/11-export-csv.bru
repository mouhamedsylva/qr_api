meta {
  name: Export CSV
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/restaurants/{{restaurantId}}/orders/export.csv
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

tests {
  test("Statut 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("CSV", function () {
    expect(res.getHeader("content-type")).to.include("text/csv");
  });
}
