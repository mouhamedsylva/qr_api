meta {
  name: Accepter la commande
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/restaurants/{{restaurantId}}/orders/{{orderId}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

body:json {
  {
    "status": "ACCEPTED"
  }
}

tests {
  test("Statut 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
