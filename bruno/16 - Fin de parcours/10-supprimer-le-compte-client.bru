meta {
  name: Supprimer le compte client
  type: http
  seq: 10
}

delete {
  url: {{baseUrl}}/auth/me
  body: json
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

body:json {
  {
    "password": "{{password}}"
  }
}

tests {
