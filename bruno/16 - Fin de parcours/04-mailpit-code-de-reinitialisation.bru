meta {
  name: Mailpit · code de réinitialisation
  type: http
  seq: 4
}

get {
  url: {{mailpitUrl}}/api/v1/search?query=to:{{ownerEmail}}
  body: none
  auth: none
}

script:post-response {
  const mail = res.getBody().messages.find((m) => m.Subject.includes("Réinitialisation"));
  bru.setVar("mailId", mail ? mail.ID : "");
}

tests {
  test("Statut 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
