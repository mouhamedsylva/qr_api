meta {
  name: Mailpit · lire le code de réinitialisation
  type: http
  seq: 5
}

get {
  url: {{mailpitUrl}}/api/v1/message/{{mailId}}
  body: none
  auth: none
}

script:post-response {
  const m = /(\d{6})/.exec(res.getBody().Text);
  bru.setVar("otpCode", m ? m[1] : "");
}

tests {
  test("Statut 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
