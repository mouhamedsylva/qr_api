meta {
  name: Récompense : bissap offert
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/restaurants/{{restaurantId}}/loyalty/rewards
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

body:json {
  {
    "name": "Bissap offert",
    "pointsCost": 30,
    "type": "FREE_ITEM",
    "menuItemId": "{{itemBissap}}"
  }
}

script:post-response {
  bru.setVar("rewardId", res.getBody().id);
}

tests {
  test("Statut 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
