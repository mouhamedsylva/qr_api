meta {
  name: Créer un code promo -10 %
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/restaurants/{{restaurantId}}/promotions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

body:json {
  {
    "code": "{{promoCode}}",
    "name": "Bienvenue -10 %",
    "type": "PERCENT",
    "value": 1000
  }
}

tests {
  test("Statut 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  value en points de base : 1000 = 10 %.
}
