meta {
  name: Activer le forfait Premium
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/admin/subscriptions/{{ownerUserId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "planCode": "PREMIUM",
    "status": "ACTIVE",
    "billingCycle": "MONTHLY",
    "currentPeriodEnd": "{{periodEnd}}"
  }
}

script:pre-request {
  bru.setVar("periodEnd", new Date(Date.now() + 30 * 86400000).toISOString());
}

tests {
  test("Statut 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Premium actif", function () {
    expect(res.getBody().plan.code).to.equal("PREMIUM");
    expect(res.getBody().status).to.equal("ACTIVE");
  });
}
