meta {
  name: Encaisser en espèces
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/restaurants/{{restaurantId}}/orders/{{orderId}}/payments/cash
  body: json
  auth: bearer
}

headers {
  Idempotency-Key: {{idemKey}}
}

auth:bearer {
  token: {{staffToken}}
}

body:json {
  {
    "amountReceived": 10000
  }
}

script:pre-request {
  bru.setVar("idemKey", "k" + Date.now() + Math.random().toString(36).slice(2, 10));
}

script:post-response {
  bru.setVar("cashPaymentId", res.getBody().payment.id);
}

tests {
  test("Statut 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("Monnaie à rendre calculée", function () {
    expect(res.getBody().change).to.be.above(0);
  });
}
