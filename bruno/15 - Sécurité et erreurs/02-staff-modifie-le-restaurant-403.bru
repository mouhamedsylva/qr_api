meta {
  name: Staff modifie le restaurant → 403
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/restaurants/{{restaurantId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}

body:json {
  {
    "name": "Piraté"
  }
}

tests {
  test("Statut 403", function () {
    expect(res.getStatus()).to.equal(403);
  });

  test("PERMISSION_DENIED", function () {
    expect(res.getBody().code).to.equal("PERMISSION_DENIED");
  });
}
