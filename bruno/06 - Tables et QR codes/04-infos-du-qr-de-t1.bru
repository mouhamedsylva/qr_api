meta {
  name: Infos du QR de T1
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/restaurants/{{restaurantId}}/tables/{{tableId}}/qr
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

script:post-response {
  bru.setVar("qrToken", res.getBody().url.split("/t/")[1]);
}

tests {
  test("Statut 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
