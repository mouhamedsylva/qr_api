NODE_ENV=development
PORT=3000
# Laragon : utilisateur root sans mot de passe par défaut
DATABASE_URL="mysql://root:@localhost:3306/qr_order"
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3001,http://localhost:5173
LOG_LEVEL=debug
# Secret de signature des QR codes de table (min. 32 caractères)
QR_SIGNING_SECRET=change-me-qr-signing-secret-min-32-chars
# URL de la PWA client encodée dans les QR codes
CLIENT_APP_URL=http://localhost:5173

# Paiements (module 6)
# Clés Stripe (laisser vide pour désactiver la carte bancaire)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Commission plateforme en points de base (250 = 2,5 %)
PLATFORM_COMMISSION_BP=0
# Simulateur mobile money / carte : JAMAIS en production
PAYMENTS_SANDBOX_ENABLED=false


# Emails (SMTP). En local : Mailpit de Laragon (interface http://localhost:8025).
# 127.0.0.1 plutôt que localhost : nodemailer interroge sinon le DNS (≈ 6 s au 1er envoi).
# Vide = emails écrits dans les logs
SMTP_URL=smtp://127.0.0.1:1025
SMTP_FROM="QR-Order <no-reply@qr-order.local>"
# Tâches planifiées (relances, rapprochements, purge, envois en attente)
JOBS_ENABLED=true

# Redis (facultatif) : plusieurs instances. En local : Redis de Laragon
# REDIS_URL=redis://127.0.0.1:6379
